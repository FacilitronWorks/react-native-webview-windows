<?xml version="1.0" encoding="utf-8"?>
<!--
  Required for `msbuild windows/ReactNativeWebViewWindows.sln /t:Restore`
  (UseExperimentalNuget=true, PackageReference-based) to resolve on a clean
  machine/CI.

  Microsoft.ReactNative / Microsoft.ReactNative.Cxx are NOT published to the
  public nuget.org gallery: they are published only to Microsoft's
  react-native-windows Azure DevOps feed. Without this file, restore fails
  with NU1101 ("Unable to find package Microsoft.ReactNative") on any
  machine that doesn't happen to already have that feed configured globally
  and/or the exact package version pre-cached. Confirmed via
  %userprofile%\.nuget\packages\microsoft.reactnative\<ver>\.nupkg.metadata
  during standalone build validation (see README "Build validation").

  boost / Microsoft.Windows.CppWinRT / Microsoft.VCRTForwarders.140 /
  Microsoft.WindowsAppSDK* / Microsoft.Web.WebView2 all resolve from
  nuget.org normally. Source mapping mirrors upstream react-native-webview's
  own windows/../NuGet.config (react-native-webview-windows/pull/3973
  template), which has the identical split.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="Nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="react-native" value="https://pkgs.dev.azure.com/ms/react-native/_packaging/react-native-public/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="Nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="react-native">
      <package pattern="Microsoft.ReactNative*" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
